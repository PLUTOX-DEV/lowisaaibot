NODE_ENV=development
PORT=3000

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=LoWisaBot
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-value

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/lowisa_telegram_ai

# AI provider
# gemini = Google Gemini API free tier (requires a free API key)
# mock = local development responses; not real generative AI
# openrouter = optional alternative provider
AI_PROVIDER=gemini

# Google Gemini (create a key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Optional OpenRouter alternative
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=LoWisa Telegram AI

# Reserved for a future embedding/vector-search implementation.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional tuning
AI_MAX_TOKENS=1000
MEMORY_MESSAGES=8
RAG_TOP_K=5
