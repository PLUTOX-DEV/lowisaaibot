NODE_ENV=development
PORT=3000

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=LoWisaBot
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-value

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/lowisa_telegram_ai

# AI
# mock = no external AI call
# openrouter = recommended
AI_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
# Current OpenRouter Auto Router. You can replace this with any model ID from the OpenRouter model catalog.
OPENROUTER_MODEL=openrouter/auto
# Optional attribution headers shown by OpenRouter. Leave blank if not needed.
OPENROUTER_SITE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_NAME=LoWisa Telegram AI

# Reserved for a future embedding/vector-search implementation.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional tuning
AI_MAX_TOKENS=1000
MEMORY_MESSAGES=8
RAG_TOP_K=5
